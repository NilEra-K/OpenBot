{
  "name": "@openbot/desktop",
  "version": "0.1.126",
  "private": true,
  "license": "Apache-2.0",
  "author": "BoneSue",
  "type": "module",
  "description": "Electron 桌面壳——P2：真内核装配 + 环回网关 + Vue renderer（五视图）",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "electron .",
    "start:debug": "electron --remote-debugging-port=9333 .",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "bundle:main": "esbuild src/main/index.ts --bundle --platform=node --format=esm --external:electron --sourcemap --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/main/index.js",
    "bundle:preload": "esbuild src/preload/index.cts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.cjs",
    "dist": "node scripts/dist.mjs",
    "test:e2e": "pnpm -w build && pnpm bundle:main && pnpm bundle:preload && pnpm build:renderer && playwright test"
  },
  "dependencies": {
    "@openbot/boxes": "workspace:*",
    "@openbot/coordinator": "workspace:*",
    "@openbot/core": "workspace:*",
    "@openbot/llm": "workspace:*",
    "@openbot/runner": "workspace:*",
    "@openbot/state": "workspace:*",
    "@openbot/transport": "workspace:*",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.13",
    "jsqr": "^1.4.0",
    "markdown-it": "^15.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@playwright/test": "^1.62.1",
    "@types/markdown-it": "^14.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "vite": "^8.2.1",
    "ws": "^8.21.3"
  }
}
